// by Nisan and Schocken, MIT Press.
// File name: projects/5/CPU.hdl
/**
 * The Hack Central Processing unit (CPU).
 * Parses the binary code in the instruction input and executes it according to the
 * Hack machine language specification. In the case of a C-instruction, computes the
 * function specified by the instruction. If the instruction specifies to read a memory
 * value, the inM input is expected to contain this value. If the instruction specifies
 * to write a value to the memory, sets the outM output to this value, sets the addressM
 * output to the target address, and asserts the writeM output (when writeM = 0, any
 * value may appear in outM).
 * If the reset input is 0, computes the address of the next instruction and sets the
 * pc output to that value. If the reset input is 1, sets pc to 0.
 * Note: The outM and writeM outputs are combinational: they are affected by the
 * instruction's execution during the current cycle. The addressM and pc outputs are
 * clocked: although they are affected by the instruction's execution, they commit to
 * their new values only in the next cycle.
 */
CHIP CPU {
    IN inM[16],         // M value input  (M = contents of RAM[A])
       instruction[16], // Instruction for execution
       reset;           // Signals whether to re-start the current
                        // program (reset==1) or continue executing
                        // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    // ------------------------------------------------------------------------
    // 1. DECODIFICAÇÃO DA INSTRUÇÃO
    // ------------------------------------------------------------------------
    // Se instruction[15] == 0 -> Instrução A (carrega valor no Reg A)
    // Se instruction[15] == 1 -> Instrução C (executa comando/operação)
    Not(in=instruction[15], out=isAInstr);
    Not(in=isAInstr, out=isCInstr);

    // ------------------------------------------------------------------------
    // 2. REGISTRADOR A E MUX DE ENTRADA
    // ------------------------------------------------------------------------
    // O Mux antes do Reg A escolhe entre a instrução pura (Instrução A) ou a saída da ALU (Instrução C)
    Mux16(a=instruction, b=aluOut, sel=isCInstr, out=regAIn);

    // O Registrador A carrega o valor se for Instrução A OU se for Instrução C com o destino d1 ativo (instruction[5])
    Or(a=isAInstr, b=instruction[5], out=loadA);
 // CORREÇÃO: Usamos o out do ARegister para mandar o endereço para fora (addressM)
    // e também criamos o fio interno (regAOut) para usar na ALU e no PC.
    ARegister(in=regAIn, load=loadA, out=regAOut, out[0..14]=addressM);

    // ------------------------------------------------------------------------
    // 3. REGISTRADOR D E SELEÇÃO ALU (A vs M)
    // ------------------------------------------------------------------------
    // O Mux antes da ALU decide se ela vai operar com o valor do Reg A ou com o valor vindo da Memória (inM)
    // Controlado pelo bit 'a' da instrução (instruction[12])
    Mux16(a=regAOut, b=inM, sel=instruction[12], out=aluY);

    // O Registrador D só carrega a saída da ALU se for Instrução C e o destino d2 estiver ativo (instruction[4])
    And(a=isCInstr, b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=aluX);

    // ------------------------------------------------------------------------
    // 4. A UNIDADE ARITMÉTICA E LÓGICA (ALU)
    // ------------------------------------------------------------------------
    // Os pinos de controle da ALU mapeiam direto os bits c1-c6 da instrução (bits 6 a 11)
    ALU(x=aluX, y=aluY, 
        zx=instruction[11], nx=instruction[10], 
        zy=instruction[9], ny=instruction[8], 
        f=instruction[7], no=instruction[6], 
        out=aluOut, out=outM, zr=zr, ng=ng);

    // Output writeM: Só escreve na memória se for Instrução C e o destino d3 estiver ativo (instruction[3])
    And(a=isCInstr, b=instruction[3], out=writeM);

    // ------------------------------------------------------------------------
    // 5. LÓGICA DE SALTO (JUMP) E PROGRAM COUNTER (PC)
    // ------------------------------------------------------------------------
    // Descobre se a saída da ALU é positiva (nem zero, nem negativa)
    Or(a=zr, b=ng, out=zeroOrNeg);
    Not(in=zeroOrNeg, out=pos);

    // Avalia as 3 condições de pulo com base nos bits j1, j2, j3 (bits 0, 1, 2)
    And(a=instruction[2], b=ng, out=jlt);  // Jump if Less Than Zero (Negativo)
    And(a=instruction[1], b=zr, out=jeq);  // Jump if Equal to Zero (Zero)
    And(a=instruction[0], b=pos, out=jgt); // Jump if Greater Than Zero (Positivo)

    // Se qualquer uma das condições válidas for atendida, ativa o sinal de jump potencial
    Or(a=jlt, b=jeq, out=jle);
    Or(a=jle, b=jgt, out=jumpCond);

    // Só dá o Jump de fato se for uma Instrução C
    And(a=isCInstr, b=jumpCond, out=pcLoad);
    
    // Se não der jump, o PC apenas incrementa
    Not(in=pcLoad, out=pcInc);

    // O PC recebe o valor do Reg A. Se pcLoad=1, ele salta para esse endereço.
    PC(in=regAOut, load=pcLoad, inc=pcInc, reset=reset, out[0..14]=pc);
}